---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import contenu from '../data/contenu.json';
import photosMeta from '../data/photos.json';
import { t, type Lang } from '../i18n';

const langue: Lang = 'fr';
const g = contenu.galerie;
const fichiers = import.meta.glob<{ default: ImageMetadata }>('../assets/photos/*.jpg', { eager: true });
const vues = photosMeta.map((p: any) => ({ ...p, image: fichiers[`../assets/photos/${p.vers}.jpg`].default }));
---

<Base langue={langue} page="galerie" titre="Galerie — Balaou Croisières"
      description="Le lagon et la côte de Sainte-Rose, du plein jour au couchant. Photographies prises en Guadeloupe.">
  <section class="section">
    <div class="coque">
      <div class="bande">
        <p class="bande__rail">{t(g.rail, langue)}</p>
        <h1 class="bande__titre">{t(g.titre, langue)}</h1>
        <p class="bande__lead">{t(g.mention, langue)}</p>
      </div>
      <div class="mosaique">
        {vues.map((v, i) => (
          <figure class="vue monte">
            <Image src={v.image} alt={t(v.legende, langue)} widths={[400, 640, 900, 1280]}
                   sizes="(min-width: 60rem) 30vw, (min-width: 40rem) 46vw, 92vw"
                   quality={78} loading={i < 2 ? 'eager' : 'lazy'} />
            <figcaption>{t(v.legende, langue)}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .mosaique {
    display: grid; gap: clamp(0.75rem, 2vw, 1.5rem);
    grid-template-columns: repeat(auto-fit, minmax(min(17rem, 100%), 1fr));
  }
  .vue { min-width: 0; }
  .vue :global(img) {
    width: 100%; aspect-ratio: 4 / 3; object-fit: cover;
    border-radius: var(--rayon);
  }
  .vue figcaption { color: var(--encre-3); font-size: var(--t-petit); margin-top: 0.5rem; }
</style>
