---
import Base from '../../layouts/Base.astro';
import CarteSortie from '../../components/CarteSortie.astro';
import contenu from '../../data/contenu.json';
import { t, type Lang } from '../../i18n';

const langue: Lang = 'fr';
const photos = import.meta.glob<{ default: ImageMetadata }>('../../assets/photos/*.jpg', { eager: true });
const img = (nom: string) => photos[`../../assets/photos/${nom}.jpg`].default;
---

<Base langue={langue} page="sorties"
      titre="Les sorties — Balaou Croisières"
      description="Trois sorties au départ de la marina de Sainte-Rose : journée lagon et îlets, snorkeling en demi-journée, coucher de soleil.">
  <section class="section">
    <div class="coque">
      <div class="bande">
        <p class="bande__rail">{t(contenu.accueil.sortiesRail, langue)}</p>
        <h1 class="bande__titre">{t(contenu.accueil.sortiesTitre, langue)}</h1>
        <p class="bande__lead">{t(contenu.accueil.sortiesIntro, langue)}</p>
      </div>
      <div class="grille">
        {contenu.sorties.map((s, i) => (
          <CarteSortie sortie={s} photo={img(s.photo)} langue={langue} priorite={i === 0} />
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .grille {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(19rem, 100%), 1fr));
    grid-template-rows: repeat(5, auto);
    gap: clamp(1rem, 2.5vw, 1.75rem);
  }
</style>
