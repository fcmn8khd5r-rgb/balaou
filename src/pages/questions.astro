---
import Base from '../layouts/Base.astro';
import contenu from '../data/contenu.json';
import { t, type Lang } from '../i18n';
const langue: Lang = 'fr';
const q = contenu.questions;
---
<Base langue={langue} page="questions" titre="Questions — Balaou Croisières"
      description="Météo, annulation, ce qu'il faut apporter, enfants à bord, paiement : les réponses avant de réserver.">
  <section class="section">
    <div class="coque">
      <div class="bande">
        <p class="bande__rail">{t(q.rail, langue)}</p>
        <h1 class="bande__titre">{t(q.titre, langue)}</h1>
      </div>
      <div class="questions mesure">
        {/* La première est servie OUVERTE : on voit tout de suite à quoi
            ressemble une réponse. Toutes restent lisibles sans JavaScript. */}
        {q.items.map((item, i) => (
          <details class="question" open={i === 0}>
            <summary>{t(item.q, langue)}</summary>
            <p>{t(item.r, langue)}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
</Base>
<style>
  .questions { display: grid; }
  .question { border-bottom: 1px solid var(--trait); }
  .question summary {
    font-family: var(--titre); font-size: var(--t-sous); font-weight: 400;
    padding: 1.1rem 2.5rem 1.1rem 0; cursor: pointer; position: relative;
    list-style: none; min-height: 2.75rem;
  }
  .question summary::-webkit-details-marker { display: none; }
  .question summary::after {
    content: '+'; position: absolute; right: 0.25rem; top: 1rem;
    font-size: 1.5rem; line-height: 1; color: var(--lagon); font-weight: 300;
  }
  .question[open] summary::after { content: '–'; }
  .question summary:hover { color: var(--lagon); }
  .question p { padding-bottom: 1.35rem; color: var(--encre-2); max-width: var(--mesure); text-wrap: pretty; }
</style>
