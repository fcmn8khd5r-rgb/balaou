---
import Base from '../../layouts/Base.astro';
import contenu from '../../data/contenu.json';
import { t, type Lang } from '../../i18n';
interface Props { langue: Lang }
const { langue } = Astro.props;
---
<Base langue={langue} page="mentions" titre={t(contenu.pages.mentions.titre, langue)}
      description={t(contenu.pages.mentions.description, langue)}>
  <section class="section">
    <div class="coque">
      <h1 class="doc__titre">{t(contenu.legal.titre, langue)}</h1>
      <p class="doc__corps mesure">{t(contenu.legal.corps, langue)}</p>
    </div>
  </section>
</Base>
<style>
  .doc__titre { font-size: var(--t-titre); }
  .doc__corps {
    margin-top: var(--sp-bloc); font-size: var(--t-lead); text-wrap: pretty;
    /* « contact@studiomathysbocage.fr » fait vingt-neuf signes insécables :
       à 200 % de taille de texte il sortait de l'écran de 119 px. Seul
       « anywhere » agit sur la largeur minimale du contenu ; « break-word »
       n'y change rien. */
    min-width: 0; overflow-wrap: anywhere;
  }
</style>
