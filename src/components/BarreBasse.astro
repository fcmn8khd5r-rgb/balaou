---
/**
 * LA BARRE BASSE, SUR TÉLÉPHONE.
 *
 * Deux gestes, toujours sous le pouce, sur toutes les pages : réserver, et
 * écrire sur WhatsApp — le canal principal ici.
 *
 * Elle OCCUPE sa place : le corps de page porte un rembourrage égal à sa
 * hauteur. Une pastille qui flotte finit par recouvrir ce qu'elle doit
 * servir — c'est ce qui était arrivé au bouton du premier écran sur iPhone 12.
 */
import contenu from '../data/contenu.json';
import { t, route, lienWhatsapp, type Lang } from '../i18n';

interface Props { langue: Lang }
const { langue } = Astro.props;
const u = contenu.ui;
---

<nav class="basse" aria-label={t(u.navRapide, langue)}>
  <a class="btn btn--plein basse__action" href={route('reserver', langue)}>{t(u.reserver, langue)}</a>
  <a class="btn btn--vert basse__action" href={lienWhatsapp(langue)} rel="noopener">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.46 1.32 4.96L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm0 18.13h-.01a8.2 8.2 0 0 1-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.36c0-4.54 3.7-8.23 8.25-8.23a8.2 8.2 0 0 1 8.24 8.24c0 4.54-3.7 8.21-8.24 8.21Zm4.52-6.16c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.16.24-.64.8-.79.97-.14.16-.29.18-.54.06-.25-.13-1.05-.39-1.99-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.01-.38.11-.5.11-.11.25-.29.37-.43.13-.15.17-.25.25-.41.08-.17.04-.31-.02-.44-.06-.12-.56-1.34-.76-1.84-.2-.48-.41-.42-.56-.43h-.48c-.17 0-.43.06-.66.31s-.86.85-.86 2.07.89 2.4 1.01 2.56c.12.17 1.74 2.66 4.22 3.73.59.25 1.05.4 1.41.52.59.19 1.13.16 1.56.1.47-.07 1.47-.6 1.67-1.18.21-.58.21-1.07.15-1.18-.06-.1-.23-.16-.48-.29Z"/>
    </svg>
    <span>{t(u.whatsapp, langue)}</span>
  </a>
</nav>

<style>
  .basse {
    position: fixed; left: 0; right: 0; bottom: 0; z-index: 70;
    display: grid;
    /* DEUX COLONNES TANT QU'ELLES TIENNENT, UNE ENSUITE. À 200 % de taille de
       texte, « WhatsApp » et son icône réclament 234 px quand la moitié de
       l'écran en offre 151 : les boutons sortaient de l'écran de 172 px.
       « minmax(min(10rem, 100 %), 1fr) » les empile d'eux-mêmes. */
    grid-template-columns: repeat(auto-fit, minmax(min(10rem, 100%), 1fr));
    gap: 0.5rem;
    padding: 0.55rem var(--marge);
    padding-bottom: calc(0.55rem + env(safe-area-inset-bottom, 0px));
    background: var(--fond);
    border-top: 1px solid var(--trait);
  }
  .basse__action { width: 100%; }

  /* Au-delà de la bascule, la réservation vit dans la barre haute et WhatsApp
     dans le pied : deux barres feraient doublon. --barre-basse tombe alors à
     zéro, et le rembourrage du corps avec elle. */
  @media (min-width: 60rem) { .basse { display: none; } }
</style>
