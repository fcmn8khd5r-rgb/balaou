---
/**
 * LA BARRE HAUTE.
 *
 * Un visiteur pressé doit voir où cliquer sans réfléchir : les sorties, et le
 * bouton de réservation, plein, à droite. Sur téléphone le menu est un
 * <details> — il s'ouvre donc SANS JavaScript, et le contenu existe dans la
 * page quoi qu'il arrive.
 *
 * Le retrait d'encoche est appliqué à UN SEUL niveau. Posé à la fois sur le
 * corps et sur la barre, il se comptait deux fois : en paysage sur iPhone, le
 * logo se retrouvait à 151 px du bord pour 59 attendus.
 */
import contenu from '../data/contenu.json';
import { t, route, lienWhatsapp, type Lang } from '../i18n';

interface Props { langue: Lang; page: string; jumelle: string }
const { langue, page, jumelle } = Astro.props;
const u = contenu.ui;

const liens = [
  { cle: 'sorties' as const, texte: t(u.sorties, langue) },
  { cle: 'galerie' as const, texte: t(u.galerie, langue) },
  { cle: 'avis' as const, texte: t(u.avis, langue) },
  { cle: 'questions' as const, texte: t(u.questions, langue) },
];
const autre: Lang = langue === 'fr' ? 'en' : 'fr';
---

<header class="tete">
  <div class="tete__coque coque">
    <a class="marque" href={route('accueil', langue)}>
      <span class="marque__nom">Balaou</span>
      <span class="marque__suite">Croisières</span>
    </a>

    <nav class="tete__nav" aria-label={t(u.navPrincipale, langue)}>
      {liens.map((l) => (
        <a href={route(l.cle, langue)} aria-current={page === l.cle ? 'page' : undefined}>{l.texte}</a>
      ))}
    </nav>

    <div class="tete__actions">
      {/* Le sélecteur mène à la page ÉQUIVALENTE, jamais à l'accueil : un
          anglophone tombé sur la page d'une sortie veut cette sortie, pas le
          début du site. L'adresse vient du gabarit, qui la calcule déjà pour
          les balises « hreflang ». */}
      <a class="tete__langue" href={jumelle} hreflang={autre} lang={autre}>
        {autre === 'en' ? 'EN' : 'FR'}
      </a>
      <a class="btn btn--plein tete__reserver" href={route('reserver', langue)}>{t(u.reserver, langue)}</a>

      <details class="tiroir">
        <summary class="tiroir__bouton" aria-label={t(u.menu, langue)}>
          <span class="tiroir__barres" aria-hidden="true"><i></i><i></i><i></i></span>
        </summary>
        <nav class="tiroir__panneau" aria-label={t(u.navPrincipale, langue)}>
          {liens.map((l) => <a href={route(l.cle, langue)}>{l.texte}</a>)}
          <a href={jumelle} hreflang={autre} lang={autre}>{autre === 'en' ? 'English' : 'Français'}</a>
          <a href={lienWhatsapp(langue)} rel="noopener">{t(u.ecrire, langue)}</a>
        </nav>
      </details>
    </div>
  </div>
</header>

<style>
  .tete {
    position: sticky; top: 0; z-index: 60;
    background: var(--fond);
    border-bottom: 1px solid var(--trait);
    /* Pas de « backdrop-filter » : il force une recomposition à chaque image
       de défilement, très coûteuse sur iOS. */
  }
  .tete__coque {
    display: flex; align-items: center;
    /* Le pas est plafonné en vw : à 200 % de taille de texte, une borne basse
       en rem doublerait et la barre sortirait de l'écran. */
    gap: min(clamp(0.75rem, 2vw, 2rem), 4vw);
    min-height: var(--barre);
  }

  .marque {
    display: inline-flex; align-items: baseline; gap: 0.4rem;
    font-family: var(--titre); text-decoration: none; line-height: 1;
    margin-right: auto;
  }
  /* LES PLAFONDS EN VW TIENNENT LA BARRE À TOUTE TAILLE DE TEXTE.
     Une requête média en rem ne répond PAS au réglage du visiteur : dans une
     « media query », le rem vaut toujours 16 px, quelle que soit la taille
     choisie. La règle qui devait masquer « CROISIÈRES » sous 22 rem ne se
     déclenchait donc jamais, et la marque occupait 314 px sur un écran de 390.
     On plafonne donc les corps eux-mêmes. */
  .marque__nom { font-size: min(1.35rem, 7vw); font-weight: 600; letter-spacing: -0.02em; }
  .marque__suite {
    font-size: min(var(--t-rail), 3.2vw); font-weight: 400; letter-spacing: 0.16em;
    text-transform: uppercase; color: var(--lagon); white-space: nowrap;
  }
  /* Sous 24 rem de LARGEUR RÉELLE, le mot cède la place — et « container »
     n'étant pas nécessaire ici, on s'en tient à une largeur en vw. */
  @media (max-width: 22rem) { .marque__suite { display: none; } }

  .tete__nav { display: none; gap: clamp(1rem, 2.2vw, 2rem); }
  .tete__nav a {
    font-family: var(--titre); font-size: var(--t-menu); font-weight: 400;
    text-decoration: none; color: var(--encre-2);
    padding-block: 0.75rem; position: relative;
  }
  .tete__nav a:hover { color: var(--encre); }
  .tete__nav a[aria-current='page'] { color: var(--encre); }
  .tete__nav a[aria-current='page']::after {
    content: ''; position: absolute; left: 0; right: 0; bottom: 0.45rem;
    height: 1px; background: var(--lagon);
  }

  .tete__actions { display: flex; align-items: center; gap: 0.5rem; }
  .tete__langue {
    display: inline-flex; align-items: center; justify-content: center;
    min-width: min(2.5rem, 12vw); min-height: min(2.5rem, 12vw);
    font-family: var(--titre); font-size: min(var(--t-petit), 3.6vw); font-weight: 600;
    letter-spacing: 0.06em; text-decoration: none; color: var(--encre-2);
    border: 1px solid var(--trait-fort); border-radius: 999px;
  }
  .tete__langue:hover { color: var(--lagon); border-color: var(--lagon); }

  /* Le bouton de réservation de la barre est réservé à l'ordinateur : sur
     téléphone, il vit dans la barre basse, toujours sous le pouce. */
  .tete__reserver { display: none; }

  .tiroir { position: relative; }
  .tiroir__bouton {
    display: inline-flex; align-items: center; justify-content: center;
    width: min(2.75rem, 13vw); height: min(2.75rem, 13vw); cursor: pointer; list-style: none;
    border: 1px solid var(--trait-fort); border-radius: 999px;
  }
  .tiroir__bouton::-webkit-details-marker { display: none; }
  .tiroir__barres { display: grid; gap: 4px; }
  .tiroir__barres i { display: block; width: 18px; height: 1.5px; background: var(--encre); }
  .tiroir[open] .tiroir__barres i:nth-child(2) { opacity: 0; }

  /* UN <details> FERMÉ N'EFFACE PAS SON PANNEAU.
     Dans Chrome, « ::details-content » en fait un bloc conteneur : le panneau
     garde « display: grid » et une boîte réelle, absolument positionnée hors
     de l'écran. Mesuré à 200 % de taille de texte : 172 px de débordement
     venaient d'un menu que personne n'avait ouvert. On l'efface donc
     explicitement tant que le tiroir est replié. */
  .tiroir:not([open]) .tiroir__panneau { display: none; }

  .tiroir__panneau {
    position: absolute; right: 0; top: calc(100% + 0.6rem);
    display: grid; gap: 0.25rem;
    /* 13 rem valent 416 px à 200 % de taille de texte, pour un écran de 390 :
       la largeur minimale doit céder avant l'écran. */
    min-width: min(13rem, calc(100vw - 2rem));
    max-width: calc(100vw - 2rem);
    background: var(--fond); border: 1px solid var(--trait);
    border-radius: var(--rayon); padding: 0.5rem;
    box-shadow: 0 12px 32px rgb(22 36 46 / 0.10);
  }
  .tiroir__panneau a {
    font-family: var(--titre); font-size: var(--t-menu); text-decoration: none;
    padding: 0.7rem 0.85rem; border-radius: 0.5rem; color: var(--encre);
  }
  .tiroir__panneau a:hover { background: var(--surface); color: var(--lagon); }

  @media (min-width: 60rem) {
    .tete__nav { display: flex; }
    .tete__reserver { display: inline-flex; }
    .tiroir { display: none; }
  }
</style>
